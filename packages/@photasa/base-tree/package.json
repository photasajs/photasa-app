{
    "name": "@photasa/base-tree",
    "version": "2.1.0",
    "private": true,
    "description": "Virtualized BaseTree components for Photasa",
    "type": "module",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "dependencies": {
        "@tanstack/vue-virtual": "^3.13.12"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.0",
        "@vue/test-utils": "^2.4.6",
        "happy-dom": "^20.11.0",
        "typescript": "^5.9.2",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^3.9.1",
        "vitest": "^4.1.10",
        "vue": "^3.5.14",
        "vue-tsc": "^2.2.10"
    }
}
